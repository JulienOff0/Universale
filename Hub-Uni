local function makeSlider(parent, title, min, max, default, y, cb, fmt)
    local c = Instance.new("Frame")
    c.BackgroundTransparency = 1; c.Position = UDim2.fromOffset(12, y or 40); c.Size = UDim2.new(1,-24,0,48); c.Parent = parent
    
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1; lbl.Size = UDim2.new(1,0,0,16)
    lbl.Font = Enum.Font.Gotham; lbl.TextSize = 11; lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextColor3 = C.sub; lbl.Text = title .. ": " .. (fmt and fmt(default) or tostring(default)); lbl.Parent = c
    
    local track = Instance.new("Frame")
    track.BackgroundColor3 = C.dark; track.BorderSizePixel = 0; track.Position = UDim2.fromOffset(0,20)
    track.Size = UDim2.new(1,0,0,6); track.Parent = c
    Instance.new("UICorner", track).CornerRadius = UDim.new(0,3)
    
    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = C.accent; fill.BorderSizePixel = 0; fill.Size = UDim2.fromOffset(0,6); fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0,3)
    
    local thumb = Instance.new("Frame")
    thumb.AnchorPoint = Vector2.new(0.5,0.5); thumb.Size = UDim2.fromOffset(12,12)
    thumb.Position = UDim2.fromOffset(0,3); thumb.BackgroundColor3 = C.text; thumb.BorderSizePixel = 0; thumb.Parent = fill
    Instance.new("UICorner", thumb).CornerRadius = UDim.new(1,0)
    
    local drag = false
    local function update(x)
        local ax = track.AbsolutePosition.X; local aw = track.AbsoluteSize.X
        local r = math.clamp((x - ax) / aw, 0, 1)
        local v = math.clamp(math.floor(min + (max-min)*r + 0.5), min, max)
        local w = math.floor(aw * r)
        fill.Size = UDim2.fromOffset(w, 6); thumb.Position = UDim2.fromOffset(w, 3)
        lbl.Text = title .. ": " .. (fmt and fmt(v) or tostring(v))
        if cb then cb(v) end
    end
    
    spawn(function()
        local aw = track.AbsoluteSize.X
        local r = (default-min)/(max-min); local w = math.floor(aw * r)
        fill.Size = UDim2.fromOffset(w, 6); thumb.Position = UDim2.fromOffset(w, 3)
    end)
    
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true; update(i.Position.X) end
    end)
    UIS.InputChanged:Connect(function(i)
        if drag and i.UserInputType == Enum.UserInputType.MouseMovement then update(i.Position.X) end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
    end)
end

