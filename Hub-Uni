Players.PlayerRemoving:Connect(function(pl)
    rebuildPlayersCache()
    -- Nettoie les hitbox du joueur qui part
    if S._hitboxParts[pl] then
        S._hitboxParts[pl] = nil
    end
    if S._hitboxCircles[pl] then
        if S._hitboxCircles[pl].Parent then
            S._hitboxCircles[pl]:Destroy()
        end
        S._hitboxCircles[pl] = nil
    end
end)

