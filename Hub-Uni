    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = toggle
    
    local knob = Instance.new("Frame")
    knob.Name = "Knob"
    knob.Size = UDim2.fromOffset(22, 22)
    knob.Position = defaultState and UDim2.fromOffset(27, 3) or UDim2.fromOffset(3, 3)
    knob.BackgroundColor3 = Theme.Text
    knob.BorderSizePixel = 0
    knob.Parent = toggle
    
    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob
    
    local state = defaultState or false
    
    local function setState(newState)
        state = newState
        local targetColor = state and Theme.Success or Theme.SurfaceLight
        local targetPosition = state and UDim2.fromOffset(27, 3) or UDim2.fromOffset(3, 3)
        
        createTween(toggle, { BackgroundColor3 = targetColor }, 0.2)
        createTween(knob, { Position = targetPosition }, 0.2)
    end
    
    toggle.MouseButton1Click:Connect(function()
        setState(not state)
    end)
    
    return {
        Button = toggle,
        Knob = knob,
        SetState = setState,
        GetState = function() return state end
    }
end

-- Créer un slider
function UIComponents.CreateSlider(parent, title, min, max, default, yOffset, callback, formatFunc)
    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Position = UDim2.fromOffset(14, yOffset or 50)
    container.Size = UDim2.new(1, -28, 0, 55)
    container.Parent = parent
    
    -- Label
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 0, 18)
    label.Font = Enum.Font.Gotham
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextColor3 = Theme.TextSecondary
    label.Parent = container
    
    local function formatValue(v)
        if formatFunc then return formatFunc(v) else return tostring(v) end
    end
    
    label.Text = title .. ": " .. formatValue(default)
    
    -- Barre de fond
    local track = Instance.new("Frame")
    track.Name = "Track"
    track.BackgroundColor3 = Theme.SurfaceLight
    track.BorderSizePixel = 0
    track.Position = UDim2.fromOffset(0, 24)
    track.Size = UDim2.new(1, 0, 0, 6)
    track.Parent = container
    
    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(0, 3)
    trackCorner.Parent = track
    
    -- Barre de progression
    local fill = Instance.new("Frame")
    fill.Name = "Fill"
    fill.BackgroundColor3 = Theme.Accent
    fill.BorderSizePixel = 0
    fill.Size = UDim2.fromOffset(0, 6)
    fill.Parent = track
    
    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(0, 3)
    fillCorner.Parent = fill
    
    -- Curseur
    local thumb = Instance.new("Frame")
    thumb.Name = "Thumb"
    thumb.AnchorPoint = Vector2.new(0.5, 0.5)
    thumb.Position = UDim2.fromOffset(0, 3)
    thumb.Size = UDim2.fromOffset(14, 14)
    thumb.BackgroundColor3 = Theme.Text
    thumb.BorderSizePixel = 0
    thumb.Parent = fill
    
    local thumbCorner = Instance.new("UICorner")
    thumbCorner.CornerRadius = UDim.new(1, 0)
    thumbCorner.Parent = thumb
    
    -- Logique du slider
    local currentValue = default
    local isDragging = false
    
    local function updateFromPosition(xPosition)
        local trackAbsolute = track.AbsolutePosition.X
        local trackWidth = track.AbsoluteSize.X
        local relativePosition = math.clamp((xPosition - trackAbsolute) / trackWidth, 0, 1)
        local newValue = math.floor(min + (max - min) * relativePosition + 0.5)
        newValue = math.clamp(newValue, min, max)
        
        currentValue = newValue
        local fillWidth = math.floor(trackWidth * relativePosition)
        fill.Size = UDim2.fromOffset(fillWidth, 6)
        thumb.Position = UDim2.fromOffset(fillWidth, 3)
        label.Text = title .. ": " .. formatValue(newValue)
        
        if callback then
            callback(newValue)
        end
    end
    
    -- Initialisation
    task.wait()
    local initialRatio = (default - min) / (max - min)
    local initialWidth = math.floor(track.AbsoluteSize.X * initialRatio)
    fill.Size = UDim2.fromOffset(initialWidth, 6)
    thumb.Position = UDim2.fromOffset(initialWidth, 3)
    
    -- Événements
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDragging = true
            updateFromPosition(input.Position.X)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if isDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateFromPosition(input.Position.X)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDragging = false
        end
    end)
    
    return {
        SetValue = function(v)
            v = math.clamp(v, min, max)
            updateFromPosition(track.AbsolutePosition.X + track.AbsoluteSize.X * ((v - min) / (max - min)))
        end,
        GetValue = function() return currentValue end
    }
end

