-- Cacher le menu
HideButton.MouseButton1Click:Connect(function()
    UI.Enabled = false
    State.UI_Visible = false
end)

-- Panic (Alt+P ou bouton)
local function panicMode()
    -- Désactive tout
    State.Speed.enabled = false; SpeedModule.Disable()
    State.Fly.enabled = false; FlyModule.Disable()
    State.Light.enabled = false; LightDisable()
    State.ESP.enabled = false; ESPDisable()
    State.Hitbox.enabled = false; HitboxDisable()
    State.AimbotNormal.enabled = false; AimbotNormalDisable()
    State.AimbotEnhanced.enabled = false; AimbotEnhancedDisable()
    State.AntiAFK.enabled = false; AntiAFKDisable()
    State.ClickTP.enabled = false
    UI.Enabled = false
    State.UI_Visible = false
end

PanicButton.MouseButton1Click:Connect(panicMode)

-- Raccourcis clavier
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.UserInputType == Enum.UserInputType.Keyboard then
        local key = input.KeyCode
        
        -- Afficher/Cacher l'UI
        if key == Enum.KeyCode.F2 or key == Enum.KeyCode.Insert or key == Enum.KeyCode.RightControl then
            UI.Enabled = not UI.Enabled
            State.UI_Visible = UI.Enabled
        elseif key == Enum.KeyCode.Four and (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)) then
            UI.Enabled = not UI.Enabled
            State.UI_Visible = UI.Enabled
        end
        
        -- Panic
        if key == Enum.KeyCode.P and (UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt)) then
            panicMode()
        end
        
        -- Click TP
        if key == Enum.KeyCode.LeftAlt and State.ClickTP.enabled then
            task.spawn(function()
                task.wait(0.05)
                if not UserInputService:IsKeyDown(Enum.KeyCode.P) then
                    ClickTPPerform()
                end
            end)
        end
    end
end)

