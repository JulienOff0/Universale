local function safeParent(gui)
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
    pcall(function() if syn and syn.protect_gui then syn.protect_gui(gui) end end)
    local ok, core = pcall(function() return game:GetService("CoreGui") end)
    gui.Parent = ok and core or LP:WaitForChild("PlayerGui")
end

local function tween(o,t,props)
    local tw = TS:Create(o, TweenInfo.new(t or .18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

local function disconnect(c) if c then c:Disconnect() end end

