-- FLY
local function flyEnable()
    local char = LP.Character
    if not char then return end
    local hrp = char:WaitForChild("HumanoidRootPart")
    local hum = char:WaitForChild("Humanoid")
    hum.PlatformStand = true
    
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp
    
    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.CFrame = hrp.CFrame
    bg.D = 50
    bg.P = 10000
    bg.Parent = hrp
    
    S.connections.fly = RS.RenderStepped:Connect(function()
        if not S.flyOn then return end
        local dir = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0,1,0) end
        if dir.Magnitude > 0 then dir = dir.Unit end
        bv.Velocity = dir * S.flySpeed
        bg.CFrame = Camera.CFrame
    end)
end
local function flyDisable()
    S.flyOn = false
    if S.connections.fly then S.connections.fly:Disconnect() end
    S.connections.fly = nil
    local char = LP.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then hum.PlatformStand = false end
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BodyVelocity") or v:IsA("BodyGyro") then v:Destroy() end
        end
    end
end

-- HITBOX (TOUS LES JOUEURS)
local function applyHitbox(player)
    if player == LP then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Sauvegarde
    if not S.hitboxParts[player] then
        S.hitboxParts[player] = {
            part = hrp,
            size = hrp.Size,
            trans = hrp.Transparency,
            collide = hrp.CanCollide,
            mat = hrp.Material,
            color = hrp.BrickColor
        }
    end
    
    -- Agrandit le HRP
    local sz = S.hitboxSize
    hrp.Size = Vector3.new(sz, sz, sz)
    hrp.Transparency = 0.5
    hrp.CanCollide = false
    hrp.Material = Enum.Material.Neon
    hrp.BrickColor = BrickColor.new("Really red")
    
    -- Cercle 3D
    if not S.hitboxCircles[player] or not S.hitboxCircles[player].Parent then
        local circle = Instance.new("Part")
        circle.Name = "HC_" .. player.Name
        circle.Anchored = false
        circle.CanCollide = false
        circle.Massless = true
        circle.Size = Vector3.new(sz, sz*0.3, sz)
        circle.Transparency = 0.6
        circle.BrickColor = BrickColor.new("Really red")
        circle.Material = Enum.Material.Neon
        circle.Parent = workspace
        
        local mesh = Instance.new("CylinderMesh")
        mesh.Scale = Vector3.new(1, 0.15, 1)
        mesh.Parent = circle
        
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = circle
        weld.Part1 = hrp
        weld.Parent = circle
        
        S.hitboxCircles[player] = circle
    end
end

local function hitboxEnable()
    if S.connections.hitbox then return end
    for _, p in ipairs(S.players) do applyHitbox(p) end
    S.connections.hitbox = RS.Heartbeat:Connect(function()
        if not S.hitboxOn then return end
        for _, p in ipairs(S.players) do applyHitbox(p) end
    end)
end

local function hitboxDisable()
    if S.connections.hitbox then S.connections.hitbox:Disconnect() end
    S.connections.hitbox = nil
    
    for p, data in pairs(S.hitboxParts) do
        if data.part and data.part.Parent then
            pcall(function()
                data.part.Size = data.size
                data.part.Transparency = data.trans
                data.part.CanCollide = data.collide
                data.part.Material = data.mat
                data.part.BrickColor = data.color
            end)
        end
    end
    S.hitboxParts = {}
    
    for p, circle in pairs(S.hitboxCircles) do
        if circle and circle.Parent then circle:Destroy() end
    end
    S.hitboxCircles = {}
end

-- AIMBOT AUTO (le plus proche)
local function aimAutoEnable()
    if S.connections.aimAuto then return end
    
    -- Cercle visuel
    if not S.aimCircle then
        local gui = Instance.new("ScreenGui")
        protect(gui)
        
        S.aimCircle = Instance.new("ImageLabel")
        S.aimCircle.AnchorPoint = Vector2.new(0.5,0.5)
        S.aimCircle.Position = UDim2.fromScale(0.5,0.5)
        S.aimCircle.Size = UDim2.fromOffset(S.aimAutoRadius*80, S.aimAutoRadius*80)
        S.aimCircle.BackgroundTransparency = 1
        S.aimCircle.Image = "rbxassetid://3570695787"
        S.aimCircle.ImageColor3 = Color3.fromRGB(255,60,60)
        S.aimCircle.ImageTransparency = 0.6
        S.aimCircle.ZIndex = 10
        S.aimCircle.Parent = gui
    end
    
    S.connections.aimAuto = RS.RenderStepped:Connect(function(dt)
        if not S.aimAutoOn then return end
        
        local myChar = LP.Character
        if not myChar then return end
        local myHRP = myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end
        
        local closest = nil
        local closestDist = 15000
        
        for _, p in ipairs(S.players) do
            local c = p.Character
            if c then
                local hrp = c:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local d = (myHRP.Position - hrp.Position).Magnitude
                    if d < closestDist then
                        closestDist = d
                        closest = hrp
                    end
                end
            end
        end
        
        if not closest then
            if S.aimCircle then S.aimCircle.Visible = false end
            return
        end
        
        if S.aimCircle then S.aimCircle.Visible = true end
        
        local targetPos = closest.Position
        
        -- Offset aléatoire
        if S.aimAutoRadius > 0 then
            local angle = math.random() * math.pi * 2
            local r = math.random() * S.aimAutoRadius
            targetPos = targetPos + Vector3.new(math.cos(angle)*r, (math.random()-0.5)*S.aimAutoRadius*0.3, math.sin(angle)*r)
        end
        
        local camPos = Camera.CFrame.Position
        local want = CFrame.lookAt(camPos, targetPos)
        local s = math.clamp(S.aimAutoSmooth/100, 0, 1)
        if s <= 0.01 then
            Camera.CFrame = want
        else
            Camera.CFrame = Camera.CFrame:Lerp(want, 1 - math.pow(1-s, dt*60))
        end
    end)
end

local function aimAutoDisable()
    if S.connections.aimAuto then S.connections.aimAuto:Disconnect() end
    S.connections.aimAuto = nil
    if S.aimCircle then
        S.aimCircle.Parent:Destroy()
        S.aimCircle = nil
    end
end

-- AIMBOT NORMAL
local function aimEnable()
    if S.connections.aim then return end
    S.connections.aim = RS.RenderStepped:Connect(function(dt)
        if not S.aimOn then return end
        if not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
        if not S.aimTarget then return end
        
        local p = Players:GetPlayerByUserId(S.aimTarget)
        if not p or not p.Character then return end
        local head = p.Character:FindFirstChild("Head")
        if not head then return end
        
        local camPos = Camera.CFrame.Position
        local want = CFrame.lookAt(camPos, head.Position)
        local s = math.clamp(S.aimSmooth/100, 0, 1)
        if s <= 0.01 then
            Camera.CFrame = want
        else
            Camera.CFrame = Camera.CFrame:Lerp(want, 1 - math.pow(1-s, dt*60))
        end
    end)
end
local function aimDisable()
    if S.connections.aim then S.connections.aim:Disconnect() end
    S.connections.aim = nil
end

