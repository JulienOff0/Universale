-- HITBOX ÉTENDUE (sur TOUS les joueurs)
local function HitboxEnable()
    if State.Connections.Hitbox then return end
    
    local function applyHitbox(player)
        if player == LocalPlayer then return end
        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        -- Sauvegarde l'état original
        if not State.HitboxData.modifiedParts[player] then
            State.HitboxData.modifiedParts[player] = {
                part = hrp,
                originalSize = hrp.Size,
                originalTransparency = hrp.Transparency,
                originalCanCollide = hrp.CanCollide,
                originalMaterial = hrp.Material,
                originalColor = hrp.BrickColor
            }
        end
        
        -- Agrandit le HRP (c'est ça qui fait que les tirs touchent plus facilement !)
        local size = State.Hitbox.size
        hrp.Size = Vector3.new(size, size, size)
        hrp.Transparency = State.Hitbox.transparency
        hrp.CanCollide = false
        hrp.Material = Enum.Material.Neon
        hrp.BrickColor = BrickColor.new("Really red")
        
        -- Crée un cercle visuel 3D dans le workspace (indépendant de l'UI)
        if not State.HitboxData.visualCircles[player] or not State.HitboxData.visualCircles[player].Parent then
            local circle = Instance.new("Part")
            circle.Name = "HitboxCircle_" .. player.Name
            circle.Anchored = false
            circle.CanCollide = false
            circle.Massless = true
            circle.Size = Vector3.new(size, size * 0.3, size)
            circle.Transparency = State.Hitbox.transparency
            circle.BrickColor = BrickColor.new("Really red")
            circle.Material = Enum.Material.Neon
            circle.Parent = workspace -- Dans le workspace, pas dans l'UI !
            
            -- Forme cylindrique
            local mesh = Instance.new("CylinderMesh")
            mesh.Scale = Vector3.new(1, 0.2, 1)
            mesh.Parent = circle
            
            -- Attache au HRP
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = circle
            weld.Part1 = hrp
            weld.Parent = circle
            
            State.HitboxData.visualCircles[player] = circle
        end
    end
    
    -- Applique sur tous les joueurs existants
    for _, player in ipairs(State.PlayersCache) do
        applyHitbox(player)
    end
    
    -- Rafraîchit périodiquement
    State.Connections.Hitbox = RunService.Heartbeat:Connect(function()
        if not State.Hitbox.enabled then return end
        for _, player in ipairs(State.PlayersCache) do
            if player ~= LocalPlayer then
                applyHitbox(player)
            end
        end
    end)
end

local function HitboxDisable()
    disconnectConnection(State.Connections.Hitbox)
    State.Connections.Hitbox = nil
    
    -- Restaure les HRP
    for player, data in pairs(State.HitboxData.modifiedParts) do
        if data and data.part and data.part.Parent then
            pcall(function()
                data.part.Size = data.originalSize
                data.part.Transparency = data.originalTransparency
                data.part.CanCollide = data.originalCanCollide
                data.part.Material = data.originalMaterial
                data.part.BrickColor = data.originalColor
            end)
        end
    end
    State.HitboxData.modifiedParts = {}
    
    -- Détruit les cercles visuels
    for player, circle in pairs(State.HitboxData.visualCircles) do
        if circle and circle.Parent then
            circle:Destroy()
        end
    end
    State.HitboxData.visualCircles = {}
end

-- AIMBOT AMÉLIORÉ (AUTO - cible le joueur le plus proche)
local function AimbotEnhancedEnable()
    if State.Connections.AimbotEnhanced then return end
    
    -- Crée le cercle visuel sur l'écran (dans son propre ScreenGui)
    if State.AimbotEnhanced.showCircle then
        if State.AimCircleGui then State.AimCircleGui:Destroy() end
        
        State.AimCircleGui = Instance.new("ScreenGui")
        State.AimCircleGui.Name = "AimCircleGui"
        protectGui(State.AimCircleGui)
        
        State.AimCircleVisual = Instance.new("ImageLabel")
        State.AimCircleVisual.Name = "AimCircle"
        State.AimCircleVisual.AnchorPoint = Vector2.new(0.5, 0.5)
        State.AimCircleVisual.Position = UDim2.fromScale(0.5, 0.5)
        State.AimCircleVisual.BackgroundTransparency = 1
        State.AimCircleVisual.Image = "rbxassetid://3570695787"
        State.AimCircleVisual.ImageColor3 = Color3.fromRGB(255, 60, 60)
        State.AimCircleVisual.ImageTransparency = 0.6
        State.AimCircleVisual.ZIndex = 10
        State.AimCircleVisual.Parent = State.AimCircleGui
        
        local circleSize = State.AimbotEnhanced.circleRadius * 80
        State.AimCircleVisual.Size = UDim2.fromOffset(circleSize, circleSize)
    end
    
    State.Connections.AimbotEnhanced = RunService.RenderStepped:Connect(function(dt)
        if not State.AimbotEnhanced.enabled then return end
        
        -- Trouve le joueur le plus proche (automatique !)
        local closestPlayer = nil
        local closestDistance = State.AimbotEnhanced.maxDistance
        
        local myChar = LocalPlayer.Character
        if not myChar then return end
        local myHRP = myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end
        
        for _, player in ipairs(State.PlayersCache) do
            if player ~= LocalPlayer and player.Character then
                -- Vérifie l'équipe
                if State.AimbotEnhanced.ignoreTeam and player.Team == LocalPlayer.Team then
                    continue
                end
                
                local targetChar = player.Character
                local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
                if targetHRP then
                    local dist = (myHRP.Position - targetHRP.Position).Magnitude
                    if dist < closestDistance then
                        closestDistance = dist
                        closestPlayer = player
                    end
                end
            end
        end
        
        if not closestPlayer or not closestPlayer.Character then
            if State.AimCircleVisual then
                State.AimCircleVisual.Visible = false
            end
            return
        end
        
        -- Cible le HRP du joueur le plus proche
        local targetChar = closestPlayer.Character
        local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
        if not targetHRP then return end
        
        if State.AimCircleVisual then
            State.AimCircleVisual.Visible = true
        end
        
        local camPos = Camera.CFrame.Position
        local targetPos = targetHRP.Position
        
        -- Offset aléatoire dans le cercle (pour viser n'importe où dans la hitbox)
        if State.AimbotEnhanced.circleRadius > 0 then
            local angle = math.random() * math.pi * 2
            local radius = math.random() * State.AimbotEnhanced.circleRadius
            local offset = Vector3.new(
                math.cos(angle) * radius,
                (math.random() - 0.5) * State.AimbotEnhanced.circleRadius * 0.5,
                math.sin(angle) * radius
            )
            targetPos = targetPos + offset
        end
        
        -- Prédiction
        if State.AimbotEnhanced.prediction > 0 then
            local vel = targetHRP.AssemblyLinearVelocity
            targetPos = targetPos + vel * State.AimbotEnhanced.prediction
        end
        
        -- Lissage
        local wantedCFrame = CFrame.lookAt(camPos, targetPos)
        local smooth = math.clamp(State.AimbotEnhanced.smooth / 100, 0, 1)
        
        if smooth <= 0.01 then
            Camera.CFrame = wantedCFrame
        else
            local alpha = 1 - math.pow(1 - smooth, dt * 60)
            Camera.CFrame = Camera.CFrame:Lerp(wantedCFrame, math.clamp(alpha, 0, 1))
        end
    end)
end

local function AimbotEnhancedDisable()
    disconnectConnection(State.Connections.AimbotEnhanced)
    State.Connections.AimbotEnhanced = nil
    
    if State.AimCircleGui then
        State.AimCircleGui:Destroy()
        State.AimCircleGui = nil
        State.AimCircleVisual = nil
    end
end

