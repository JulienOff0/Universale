    S.clickTPOn = false
    UI.Enabled = false
end

PanicBtn.MouseButton1Click:Connect(panic)

UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        local k = input.KeyCode
        
        if k == Enum.KeyCode.F2 or k == Enum.KeyCode.Insert or k == Enum.KeyCode.RightControl then
            UI.Enabled = not UI.Enabled
        elseif k == Enum.KeyCode.Four and (UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift)) then
            UI.Enabled = not UI.Enabled
        elseif k == Enum.KeyCode.P and (UIS:IsKeyDown(Enum.KeyCode.LeftAlt) or UIS:IsKeyDown(Enum.KeyCode.RightAlt)) then
            panic()
        elseif k == Enum.KeyCode.LeftAlt and S.clickTPOn then
            task.spawn(function()
                task.wait(0.05)
                if not UIS:IsKeyDown(Enum.KeyCode.P) then clickTP() end
            end)
        end
    end
end)

