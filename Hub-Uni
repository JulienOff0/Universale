            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1,-8,0,24); b.BackgroundColor3 = C.panel; b.BorderSizePixel = 0
            b.Text = p.DisplayName ~= "" and p.DisplayName or p.Name
            b.Font = Enum.Font.Gotham; b.TextSize = 11; b.TextColor3 = C.text; b.AutoButtonColor = false; b.Parent = plist
            Instance.new("UICorner", b).CornerRadius = UDim.new(0,5)
            b.MouseButton1Click:Connect(function()
                onSelect(p); dd.Text = "Cible: " .. (p.DisplayName ~= "" and p.DisplayName or p.Name); plist.Visible = false
            end)
        end
        plist.CanvasSize = UDim2.new(0,0,0,pll.AbsoluteContentSize.Y + 8)
    end
    
    dd.MouseButton1Click:Connect(function() plist.Visible = not plist.Visible; if plist.Visible then rebuild() end end)
    ref.MouseButton1Click:Connect(function() updatePlayers(); if plist.Visible then rebuild() end end)
    
    return {dd=dd, plist=plist, rebuild=rebuild}
end

