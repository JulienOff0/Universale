-- HITBOX CIRCLE
local function applyHitbox(player)
    if player == LP then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    if not S.hitboxSaved[player] then
        S.hitboxSaved[player] = {part=hrp, size=hrp.Size, trans=hrp.Transparency, col=hrp.CanCollide, mat=hrp.Material, color=hrp.BrickColor}
    end
    
    local sz = S.hitboxSize
    hrp.Size = Vector3.new(sz, sz, sz)
    hrp.Transparency = S.hitboxTrans
    hrp.CanCollide = false
    hrp.Material = Enum.Material.Neon
    hrp.BrickColor = BrickColor.new("Really red")
    
    if not S.hitboxCircles[player] or not S.hitboxCircles[player].Parent then
        local circle = Instance.new("Part")
        circle.Name = "HC_"..player.Name; circle.Anchored = false; circle.CanCollide = false; circle.Massless = true
        circle.Size = Vector3.new(sz, sz*0.25, sz); circle.Transparency = S.hitboxTrans
        circle.BrickColor = BrickColor.new("Really red"); circle.Material = Enum.Material.Neon
        circle.Parent = workspace
        
        local mesh = Instance.new("CylinderMesh"); mesh.Scale = Vector3.new(1,0.15,1); mesh.Parent = circle
        local weld = Instance.new("WeldConstraint"); weld.Part0 = circle; weld.Part1 = hrp; weld.Parent = circle
        S.hitboxCircles[player] = circle
    end
end

local function hitboxEnable()
    if S.conns.hitbox then return end
    for _, p in ipairs(S.players) do applyHitbox(p) end
    S.conns.hitbox = RS.Heartbeat:Connect(function()
        if not S.hitboxOn then return end
        for _, p in ipairs(S.players) do applyHitbox(p) end
    end)
end

local function hitboxDisable()
    disconnect(S.conns.hitbox); S.conns.hitbox = nil
    for p, data in pairs(S.hitboxSaved) do
        if data.part and data.part.Parent then
            pcall(function() data.part.Size=data.size; data.part.Transparency=data.trans; data.part.CanCollide=data.col; data.part.Material=data.mat; data.part.BrickColor=data.color end)
        end
    end
    S.hitboxSaved = {}
    for p, c in pairs(S.hitboxCircles) do if c and c.Parent then c:Destroy() end end
    S.hitboxCircles = {}
end

