--============================================================================--
-- MODULE: CLICK TP
--============================================================================--
local function clickTP()
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local mouse = LP:GetMouse()
    local ray = mouse.UnitRay
    
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char}
    
    local result = workspace:Raycast(ray.Origin, ray.Direction * S.ctMaxDist, params)
    local pos = result and result.Position or (ray.Origin + ray.Direction * S.ctMaxDist)
    pos = pos + Vector3.new(0, S.ctHeight, 0)
    
    char:PivotTo(CFrame.new(pos))
end

