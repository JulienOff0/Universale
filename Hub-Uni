--== AIMBOT AMÉLIORÉ (avec hitbox circle) ==--
local function getAimEnhancedTarget()
    if not S.aimEnhancedTarget then return nil end
    local pl = Players:GetPlayerByUserId(S.aimEnhancedTarget)
    if not pl or not pl.Character then return nil end
    if S.aimEnhancedTeamCheck and pl.Team == LP.Team then return nil end
    
    -- Vise le HRP (qui est agrandi par la hitbox)
    local hrp = pl.Character:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp end
    
    local head = pl.Character:FindFirstChild("Head")
    if head then return head end
    
    return nil
end

local function createAimCircleVisual()
    -- Le cercle visuel est dans l'UI MAIS on le garde visible même quand le menu est caché
    if S._aimEnhancedCircleVisual then
        S._aimEnhancedCircleVisual:Destroy()
        S._aimEnhancedCircleVisual = nil
    end
    
    if not S.aimEnhancedShowCircle then return end
    
    -- Crée un ScreenGui séparé pour le cercle (indépendant du menu)
    local circleGui = Instance.new("ScreenGui")
    circleGui.Name = "AimCircleGui"
    circleGui.ResetOnSpawn = false
    circleGui.IgnoreGuiInset = true
    circleGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
    pcall(function() if syn and syn.protect_gui then syn.protect_gui(circleGui) end end)
    circleGui.Parent = game:GetService("CoreGui") or LP:WaitForChild("PlayerGui")
    
    local circle = Instance.new("ImageLabel")
    circle.Name = "AimCircle"
    circle.AnchorPoint = Vector2.new(0.5, 0.5)
    circle.Position = UDim2.new(0.5, 0, 0.5, 0)
    circle.BackgroundTransparency = 1
    circle.Image = "rbxassetid://3570695787"
    circle.ImageColor3 = Color3.fromRGB(255, 50, 50)
    circle.ImageTransparency = 0.5
    circle.ZIndex = 10
    circle.Parent = circleGui
    
    local size = S.aimEnhancedCircleRadius * 100
    circle.Size = UDim2.new(0, size, 0, size)
    
    S._aimEnhancedCircleVisual = circle
    
    -- Animation de pulsation
    task.spawn(function()
        while S._aimEnhancedCircleVisual and S._aimEnhancedCircleVisual.Parent and S.aimEnhancedShowCircle do
            local baseSize = S.aimEnhancedCircleRadius * 100
            for i = 1, 20 do
                if not S._aimEnhancedCircleVisual or not S._aimEnhancedCircleVisual.Parent then break end
                local pulse = baseSize + math.sin(i * 0.5) * 10
                S._aimEnhancedCircleVisual.Size = UDim2.new(0, pulse, 0, pulse)
                task.wait(0.05)
            end
        end
    end)
end

local function aimEnhanced_enable()
    if S._aimEnhancedConn then return end
    
    createAimCircleVisual()
    
    S._aimEnhancedConn = RS.RenderStepped:Connect(function(dt)
        if not S.aimEnhancedOn then return end
        if S.aimEnhancedHold and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
        
        local target = getAimEnhancedTarget()
        if not target then return end
        
        local cam = workspace.CurrentCamera
        if not cam then return end
        
        local camPos = cam.CFrame.Position
        local targetPos = target.Position
        
        if (camPos - targetPos).Magnitude > S.aimEnhancedMaxDist then return end
        
        -- AJOUTE UN OFFSET ALÉATOIRE DANS LE CERCLE
        -- Ça permet de viser n'importe où dans la hitbox agrandie
        if S.aimEnhancedCircleRadius > 0 then
            local randomAngle = math.random() * math.pi * 2
            local randomRadius = math.random() * S.aimEnhancedCircleRadius
            local offset = Vector3.new(
                math.cos(randomAngle) * randomRadius,
                (math.random() - 0.5) * S.aimEnhancedCircleRadius,
                math.sin(randomAngle) * randomRadius
            )
            targetPos = targetPos + offset
        end
        
        if S.aimEnhancedPredict > 0 then
            local vel = target.AssemblyLinearVelocity
            targetPos = targetPos + vel * S.aimEnhancedPredict
        end
        
        local want = CFrame.lookAt(camPos, targetPos)
        local s = math.clamp(S.aimEnhancedSmooth/100, 0, 1)
        if s <= 0 then
            cam.CFrame = want
        else
            local alpha = 1 - math.pow(1 - s, dt*60)
            cam.CFrame = cam.CFrame:Lerp(want, math.clamp(alpha,0,1))
        end
    end)
end

local function aimEnhanced_disable()
    disconnect(S._aimEnhancedConn)
    S._aimEnhancedConn = nil
    if S._aimEnhancedCircleVisual then
        S._aimEnhancedCircleVisual:Destroy()
        S._aimEnhancedCircleVisual = nil
    end
end

