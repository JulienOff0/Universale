local function rebuildPlayersCache()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            table.insert(list, p)
        end
    end
    table.sort(list, function(a,b)
        return string.lower(a.Name) < string.lower(b.Name)
    end)
    S._playersCache = list
end
rebuildPlayersCache()
