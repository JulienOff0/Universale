--== HITBOX ÉTENDUE (CORRIGÉE - Reste visible quand UI cachée) ==--
local function createHitboxForPlayer(pl)
    if not pl or pl == LP then return end
    if not pl.Character then return end
    
    local char = pl.Character
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Sauvegarde la taille originale si pas déjà fait
    if not S._hitboxParts[pl] then
        S._hitboxParts[pl] = {
            hrp = hrp,
            originalSize = hrp.Size,
            originalTransparency = hrp.Transparency,
            originalCanCollide = hrp.CanCollide,
            originalMaterial = hrp.Material,
            originalColor = hrp.BrickColor
        }
    end
    
    -- AGGRANDIT VRAIMENT le HRP (ça affecte les tirs !)
    hrp.Size = Vector3.new(S.hitboxSize, S.hitboxSize, S.hitboxSize)
    hrp.Transparency = 0.5
    hrp.CanCollide = false
    hrp.Material = Enum.Material.Neon
    hrp.BrickColor = BrickColor.new("Really red")
    
    -- Crée un cercle visuel 3D dans le workspace (pas dans l'UI !)
    if not S._hitboxCircles[pl] or not S._hitboxCircles[pl].Parent then
        local circle = Instance.new("Part")
        circle.Name = "HitboxCircle_" .. pl.Name
        circle.Anchored = false
        circle.CanCollide = false
        circle.Massless = true
        circle.Size = Vector3.new(S.hitboxSize, S.hitboxSize, S.hitboxSize)
        circle.Transparency = 0.6
        circle.BrickColor = BrickColor.new("Really red")
        circle.Material = Enum.Material.Neon
        circle.Parent = workspace -- DANS LE WORKSPACE, pas dans l'UI !
        
        -- Cylinder mesh pour forme ronde
        local mesh = Instance.new("CylinderMesh")
        mesh.Scale = Vector3.new(1, 0.3, 1)
        mesh.Parent = circle
        
        -- Weld pour suivre le joueur
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = circle
        weld.Part1 = hrp
        weld.Parent = circle
        
        S._hitboxCircles[pl] = circle
    else
        -- Met à jour la taille
        S._hitboxCircles[pl].Size = Vector3.new(S.hitboxSize, S.hitboxSize, S.hitboxSize)
    end
end

local function updateAllHitboxes()
    for _, pl in ipairs(S._playersCache) do
        if pl ~= LP then
            createHitboxForPlayer(pl)
        end
    end
end

local function removeAllHitboxes()
    -- Restaure les HRP
    for pl, data in pairs(S._hitboxParts) do
        if data and data.hrp and data.hrp.Parent then
            pcall(function()
                data.hrp.Size = data.originalSize
                data.hrp.Transparency = data.originalTransparency
                data.hrp.CanCollide = data.originalCanCollide
                data.hrp.Material = data.originalMaterial
                data.hrp.BrickColor = data.originalColor
            end)
        end
    end
    S._hitboxParts = {}
    
    -- Détruit les cercles visuels
    for pl, circle in pairs(S._hitboxCircles) do
        if circle and circle.Parent then
            circle:Destroy()
        end
    end
    S._hitboxCircles = {}
end

local function hitbox_enable()
    if S._hitboxConn then return end
    updateAllHitboxes()
    
    -- Rafraîchit périodiquement
    S._hitboxConn = RS.Heartbeat:Connect(function()
        if not S.hitboxOn then return end
        updateAllHitboxes()
    end)
    
    -- Écoute les nouveaux personnages
    local function onCharAdded(pl, char)
        if pl ~= LP and S.hitboxOn then
            task.wait(0.3)
            createHitboxForPlayer(pl)
        end
    end
    
    for _, pl in ipairs(S._playersCache) do
        if pl ~= LP then
            pl.CharacterAdded:Connect(function(char) onCharAdded(pl, char) end)
        end
    end
end

local function hitbox_disable()
    disconnect(S._hitboxConn)
    S._hitboxConn = nil
    removeAllHitboxes()
end

--== AIMBOT NORMAL ==--
local function getAimNormalTarget()
    if not S.aimNormalTarget then return nil end
    local pl = Players:GetPlayerByUserId(S.aimNormalTarget)
    if not pl or not pl.Character then return nil end
    if S.aimNormalTeamCheck and pl.Team == LP.Team then return nil end
    local head = pl.Character:FindFirstChild("Head")
    if not head then return nil end
    return head
end

local function aimNormal_enable()
    if S._aimNormalConn then return end
    S._aimNormalConn = RS.RenderStepped:Connect(function(dt)
        if not S.aimNormalOn then return end
        if S.aimNormalHold and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
        
        local target = getAimNormalTarget()
        if not target then return end
        
        local cam = workspace.CurrentCamera
        if not cam then return end
        
        local camPos = cam.CFrame.Position
        local targetPos = target.Position
        
        if (camPos - targetPos).Magnitude > S.aimNormalMaxDist then return end
        
        if S.aimNormalPredict > 0 then
            local vel = target.AssemblyLinearVelocity
            targetPos = targetPos + vel * S.aimNormalPredict
        end
        
        local want = CFrame.lookAt(camPos, targetPos)
        local s = math.clamp(S.aimNormalSmooth/100, 0, 1)
        if s <= 0 then
            cam.CFrame = want
        else
            local alpha = 1 - math.pow(1 - s, dt*60)
            cam.CFrame = cam.CFrame:Lerp(want, math.clamp(alpha,0,1))
        end
    end)
end

local function aimNormal_disable()
