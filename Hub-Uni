local function makeToggle(parent, default, x)
    local btn = Instance.new("TextButton")
    btn.AnchorPoint = Vector2.new(1,0)
    btn.Position = UDim2.new(1, -(x or 12), 0, 6)
    btn.Size = UDim2.fromOffset(48,26)
    btn.BackgroundColor3 = default and C.green or C.dark
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1,0)
    
    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(20,20)
    knob.Position = default and UDim2.fromOffset(25,3) or UDim2.fromOffset(3,3)
    knob.BackgroundColor3 = C.text
    knob.BorderSizePixel = 0
    knob.Parent = btn
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1,0)
    
    local state = default
    local function set(s)
        state = s
        local c = s and C.green or C.dark
        local p = s and UDim2.fromOffset(25,3) or UDim2.fromOffset(3,3)
        TS:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = c}):Play()
        TS:Create(knob, TweenInfo.new(0.2), {Position = p}):Play()
    end
    
    btn.MouseButton1Click:Connect(function() set(not state) end)
    
    return {btn = btn, set = set, get = function() return state end}
end

local function makeSlider(parent, title, min, max, default, y, cb, fmt)
    local c = Instance.new("Frame")
    c.BackgroundTransparency = 1
    c.Position = UDim2.fromOffset(12, y or 40)
    c.Size = UDim2.new(1,-24,0,50)
    c.Parent = parent
    
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1,0,0,16)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextColor3 = C.sub
    lbl.Text = title .. ": " .. (fmt and fmt(default) or tostring(default))
    lbl.Parent = c
    
    local track = Instance.new("Frame")
    track.BackgroundColor3 = C.dark
    track.BorderSizePixel = 0
    track.Position = UDim2.fromOffset(0,22)
    track.Size = UDim2.new(1,0,0,6)
    track.Parent = c
    Instance.new("UICorner", track).CornerRadius = UDim.new(0,3)
    
    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = C.accent
    fill.BorderSizePixel = 0
    fill.Size = UDim2.fromOffset(0,6)
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0,3)
    
    local thumb = Instance.new("Frame")
    thumb.AnchorPoint = Vector2.new(0.5,0.5)
    thumb.Size = UDim2.fromOffset(12,12)
    thumb.Position = UDim2.fromOffset(0,3)
    thumb.BackgroundColor3 = C.text
    thumb.BorderSizePixel = 0
    thumb.Parent = fill
    Instance.new("UICorner", thumb).CornerRadius = UDim.new(1,0)
    
    local drag = false
    local function update(x)
        local ax = track.AbsolutePosition.X
        local aw = track.AbsoluteSize.X
        local r = math.clamp((x - ax) / aw, 0, 1)
        local v = math.floor(min + (max-min)*r + 0.5)
        v = math.clamp(v, min, max)
        local w = math.floor(aw * r)
        fill.Size = UDim2.fromOffset(w, 6)
        thumb.Position = UDim2.fromOffset(w, 3)
        lbl.Text = title .. ": " .. (fmt and fmt(v) or tostring(v))
        if cb then cb(v) end
    end
    
    task.wait()
    update(track.AbsolutePosition.X + track.AbsoluteSize.X * ((default-min)/(max-min)))
    
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true
            update(i.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if drag and i.UserInputType == Enum.UserInputType.MouseMovement then
            update(i.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
    end)
end

