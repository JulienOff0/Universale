                dropdownBtn.Text = "Cible: " .. (pl.DisplayName ~= "" and pl.DisplayName or pl.Name)
                listHolder.Visible = false
            end)
        end
        listHolder.CanvasSize = UDim2.new(0,0,0,listLayout.AbsoluteContentSize.Y+12)
    end
    
    dropdownBtn.MouseButton1Click:Connect(function()
        listHolder.Visible = not listHolder.Visible
        if listHolder.Visible then rebuildList() end
    end)
    refreshBtn.MouseButton1Click:Connect(function()
        rebuildPlayersCache()
        if listHolder.Visible then rebuildList() end
    end)
    
    Toggle.MouseButton1Click:Connect(function()
        S.aimEnhancedOn = not S.aimEnhancedOn
        setT(S.aimEnhancedOn)
        if S.aimEnhancedOn then aimEnhanced_enable() else aimEnhanced_disable() end
    end)
end

