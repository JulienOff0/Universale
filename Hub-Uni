--============================================================================--
-- MODULE: AIMBOT MANUEL (RMB sur cible choisie)
--============================================================================--
local function aimEnable()
    if S.conns.aim then return end
    
    S.conns.aim = RS.RenderStepped:Connect(function(dt)
        if not S.aimOn then return end
        
        -- Vérifie le maintien RMB
        if S.aimHold and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
        
        if not S.aimTarget then return end
        
        local target = Players:GetPlayerByUserId(S.aimTarget)
        if not target or not target.Character then return end
        
        -- Team check
        if S.aimTeamCheck and target.Team == LP.Team then return end
        
        -- Vise la tête
        local head = target.Character:FindFirstChild("Head")
        if not head then return end
        
        local camPos = Camera.CFrame.Position
        local targetPos = head.Position + Vector3.new(0, 0.2, 0)
        
        -- Distance check
        if (camPos - targetPos).Magnitude > S.aimMaxDist then return end
        
        -- Prédiction
        if S.aimPredict > 0 then
            local vel = head.AssemblyLinearVelocity
            targetPos = targetPos + vel * S.aimPredict
        end
        
        -- Lissage
        local wanted = CFrame.lookAt(camPos, targetPos)
        local s = math.clamp(S.aimSmooth / 100, 0, 1)
        
        if s <= 0.01 then
            Camera.CFrame = wanted
        else
            local alpha = 1 - math.pow(1 - s, dt * 60)
            Camera.CFrame = Camera.CFrame:Lerp(wanted, math.clamp(alpha, 0, 1))
        end
    end)
end
local function aimDisable()
    disconnect(S.conns.aim)
    S.conns.aim = nil
end

