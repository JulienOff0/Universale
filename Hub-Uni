-- TP
local function tpToTarget()
    if not S.tpTarget then return end
    local t = Players:GetPlayerByUserId(S.tpTarget)
    if not t or not t.Character then return end
    local hrp = t.Character:FindFirstChild("HumanoidRootPart")
    if hrp then getChar():PivotTo(hrp.CFrame * CFrame.new(0,0,3)) end
end

-- AIMBOT MANUEL
local function aimEnable()
    if S.conns.aim then return end
    S.conns.aim = RS.RenderStepped:Connect(function(dt)
        if not S.aimOn then return end
        if S.aimHold and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
        if not S.aimTarget then return end
        local t = Players:GetPlayerByUserId(S.aimTarget)
        if not t or not t.Character then return end
        if S.aimTeam and t.Team == LP.Team then return end
        local head = t.Character:FindFirstChild("Head")
        if not head then return end
        
        local camPos = Camera.CFrame.Position
        local targetPos = head.Position + Vector3.new(0,0.2,0)
        if S.aimPredict > 0 then targetPos += head.AssemblyLinearVelocity * S.aimPredict end
        local want = CFrame.lookAt(camPos, targetPos)
        local s = math.clamp(S.aimSmooth/100, 0, 1)
        if s <= 0.01 then Camera.CFrame = want
        else Camera.CFrame = Camera.CFrame:Lerp(want, 1 - math.pow(1-s, dt*60)) end
    end)
end
local function aimDisable()
    disconnect(S.conns.aim); S.conns.aim = nil
end

